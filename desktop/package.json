{
  "name": "moonbit-ide",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "MoonBit 后端一站式开发平台 — 桌面 IDE 壳（Electron + Monaco）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:backend": "node test-backend.js",
    "test:api": "node test-api-debug.js",
    "test:project": "node test-project-detect.js",
    "test:gui": "electron e2e-gui.js",
    "test:features": "electron e2e-features.js",
    "test:term": "electron test-term.js",
    "test:lsp": "node test-lsp.js",
    "test:search": "node test-search.js",
    "test:all": "node test-lsp.js && node test-search.js && node test-symbols.js && node test-lsp-client.js",
    "verify:desktop": "node test-runner-detect.js && node test-project-detect.js && node test-relay.js && electron verify-welcome.js && electron verify-agent-config.js && electron verify-run-url.js && electron verify-run-dispatch.js && electron verify-relay.js && electron e2e-features.js",
    "test:lsp-client": "node test-lsp-client.js",
    "test:symbols": "node test-symbols.js",
    "fetch:opencode": "node ../tools/fetch-opencode.js",
    "dist:dir": "electron-builder --dir",
    "dist": "electron-builder --win --x64",
    "verify:demo": "node verify-demo.js",
    "verify:demo:fast": "node verify-demo.js --fast",
    "verify:multiproject": "electron verify-multiproject.js",
    "verify:problems": "electron verify-problems.js",
    "verify:agent-tools": "electron verify-agent-tools.js",
    "verify:agent-patch": "electron verify-agent-patch.js",
    "verify:agent-verify": "electron verify-agent-verify.js",
    "verify:ai-provider": "electron verify-ai-provider.js",
    "verify:agent-request": "electron verify-agent-request.js",
    "verify:agent-e2e": "electron verify-agent-e2e.js",
    "check:local-chk": "node ../tools/check-local-chk.js --ci",
    "verify:panels-smoke": "electron verify-panels-smoke.js"
  },
  "devDependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "monaco-editor": "0.56.0",
    "node-pty": "1.1.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "1.1.0"
  },
  "build": {
    "appId": "com.moonbit.platform.ide",
    "productName": "MoonBit IDE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!vendor/opencode/**",
      "!dist/**",
      "!e2e-shots/**",
      "!**/*.log"
    ],
    "extraResources": [
      {
        "from": "vendor/opencode",
        "to": "opencode",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
