{
  "name": "moonbit-ide",
  "version": "0.1.0",
  "private": true,
  "description": "MoonBit 后端一站式开发平台 — 桌面 IDE 壳（Electron + Monaco）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:backend": "node test-backend.js",
    "test:api": "node test-api-debug.js",
    "test:project": "node test-project-detect.js",
    "test:gui": "electron e2e-gui.js",
    "test:features": "electron e2e-features.js",
    "test:term": "electron test-term.js",
    "test:lsp": "node test-lsp.js",
    "test:search": "node test-search.js",
    "test:all": "node test-lsp.js && node test-search.js && node test-symbols.js && node test-lsp-client.js",
    "verify:desktop": "node test-runner-detect.js && node test-project-detect.js && node test-relay.js && electron verify-welcome.js && electron verify-agent-config.js && electron verify-run-url.js && electron verify-run-dispatch.js && electron verify-relay.js && electron e2e-features.js",
    "test:lsp-client": "node test-lsp-client.js",
    "test:symbols": "node test-symbols.js",
    "fetch:opencode": "node ../tools/fetch-opencode.js",
    "dist:dir": "electron-builder --dir",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.moonbit.platform.ide",
    "productName": "MoonBit IDE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!vendor/opencode/**",
      "!dist/**",
      "!e2e-shots/**",
      "!**/*.log"
    ],
    "extraResources": [
      {
        "from": "vendor/opencode",
        "to": "opencode",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
