  "xiewenchen/moonbit-platform/http",
  "xiewenchen/moonbit-platform/http/server",
  "xiewenchen/moonbit-platform/pg",
  "xiewenchen/moonbit-platform/pg/client" @pgclient,
  "xiewenchen/moonbit-platform/redis",
  "xiewenchen/moonbit-platform/redis/client" @redisclient,
  "moonbitlang/async",
